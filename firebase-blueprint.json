{
  "entities": {
    "Appointment": {
      "title": "Appointment",
      "description": "Patient serial booking request for Dr. Fazilatun Nesa (Bristy) at Bangladesh Eye Hospital Khulna Ltd.",
      "type": "object",
      "properties": {
        "serialCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 24,
          "pattern": "^[A-Z0-9\\-]+$",
          "description": "Unique human-readable booking reference code (e.g., BEH-482190)."
        },
        "patientName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Full name of the patient."
        },
        "phone": {
          "type": "string",
          "minLength": 11,
          "maxLength": 15,
          "pattern": "^01[3-9][0-9]{8}$",
          "description": "Bangladeshi 11-digit mobile number."
        },
        "appointmentDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "ISO date YYYY-MM-DD for the requested consultation."
        },
        "timeSlot": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "description": "Selected chamber consultation slot."
        },
        "serviceName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140,
          "description": "Requested ophthalmology service or surgical consultation."
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 600,
          "description": "Optional symptoms or clinical remarks."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "completed", "cancelled"],
          "description": "Booking lifecycle status."
        },
        "patientUid": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "Optional authenticated user UID if booked while signed in."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "serialCode",
        "patientName",
        "phone",
        "appointmentDate",
        "timeSlot",
        "serviceName",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "SerialLookup": {
      "title": "SerialLookup",
      "description": "Non-PII public serial status lookup record indexed by serialCode.",
      "type": "object",
      "properties": {
        "serialCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 24,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "appointmentDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "timeSlot": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "serviceName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "completed", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "serialCode",
        "appointmentDate",
        "timeSlot",
        "serviceName",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Patient inquiry or urgent question submitted via the contact form.",
      "type": "object",
      "properties": {
        "senderName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "minLength": 11,
          "maxLength": 15,
          "pattern": "^01[3-9][0-9]{8}$"
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["unread", "reviewed", "resolved"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["senderName", "phone", "message", "status", "createdAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized clinic staff or doctor UID grant.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["doctor", "staff"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Private patient appointment records containing PII, readable only by the owning patient or verified clinic admins."
    },
    "/serialLookups/{serialCode}": {
      "schema": { "$ref": "#/entities/SerialLookup" },
      "description": "De-identified serial tracking record allowing single-document get by serialCode without exposing PII or listing."
    },
    "/contactMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Patient inquiries submitted from the footer form, readable and manageable strictly by verified clinic admins."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Clinic staff/doctor authorization records."
    }
  }
}
