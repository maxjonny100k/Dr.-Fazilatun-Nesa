rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'maxjonny64@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidAppointment(data) {
      return data.keys().hasAll([
          'serialCode', 'patientName', 'phone', 'appointmentDate',
          'timeSlot', 'serviceName', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'serialCode', 'patientName', 'phone', 'appointmentDate',
          'timeSlot', 'serviceName', 'notes', 'status', 'patientUid',
          'createdAt', 'updatedAt'
        ])
        && data.serialCode is string
        && data.serialCode.size() >= 6 && data.serialCode.size() <= 24
        && data.serialCode.matches('^[A-Z0-9\\-]+$')
        && data.patientName is string
        && data.patientName.size() >= 2 && data.patientName.size() <= 100
        && data.phone is string
        && data.phone.size() >= 11 && data.phone.size() <= 15
        && data.phone.matches('^01[3-9][0-9]{8}$')
        && data.appointmentDate is string
        && data.appointmentDate.size() == 10
        && data.appointmentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.timeSlot is string
        && data.timeSlot.size() >= 3 && data.timeSlot.size() <= 80
        && data.serviceName is string
        && data.serviceName.size() >= 2 && data.serviceName.size() <= 140
        && (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 600))
        && (!data.keys().hasAny(['patientUid']) || (data.patientUid is string && data.patientUid.size() <= 128))
        && data.status in ['pending', 'confirmed', 'completed', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSerialLookup(data, serialCodeId) {
      return data.keys().hasAll([
          'serialCode', 'appointmentDate', 'timeSlot', 'serviceName',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'serialCode', 'appointmentDate', 'timeSlot', 'serviceName',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.serialCode is string
        && data.serialCode == serialCodeId
        && data.serialCode.size() >= 6 && data.serialCode.size() <= 24
        && data.serialCode.matches('^[A-Z0-9\\-]+$')
        && data.appointmentDate is string
        && data.appointmentDate.size() == 10
        && data.appointmentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.timeSlot is string
        && data.timeSlot.size() >= 3 && data.timeSlot.size() <= 80
        && data.serviceName is string
        && data.serviceName.size() >= 2 && data.serviceName.size() <= 140
        && data.status in ['pending', 'confirmed', 'completed', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['senderName', 'phone', 'message', 'status', 'createdAt'])
        && data.keys().hasOnly(['senderName', 'phone', 'message', 'status', 'createdAt'])
        && data.senderName is string
        && data.senderName.size() >= 2 && data.senderName.size() <= 100
        && data.phone is string
        && data.phone.size() >= 11 && data.phone.size() <= 15
        && data.phone.matches('^01[3-9][0-9]{8}$')
        && data.message is string
        && data.message.size() >= 5 && data.message.size() <= 1000
        && data.status in ['unread', 'reviewed', 'resolved']
        && data.createdAt is timestamp;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt'])
        && data.keys().hasOnly(['email', 'role', 'createdAt'])
        && data.email is string
        && data.email.size() >= 5 && data.email.size() <= 160
        && data.role in ['doctor', 'staff']
        && data.createdAt is timestamp;
    }

    // --- Collection: appointments ---
    match /appointments/{appointmentId} {
      allow get: if isValidId(appointmentId) && (
        isAdmin() ||
        (isVerifiedUser() && existing().patientUid == request.auth.uid)
      );

      allow list: if isAdmin() || (
        isVerifiedUser() && resource.data.patientUid == request.auth.uid
      );

      allow create: if isValidId(appointmentId)
        && isValidAppointment(incoming())
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (!incoming().keys().hasAny(['patientUid']) || incoming().patientUid == '') ||
          (isVerifiedUser() && incoming().patientUid == request.auth.uid)
        )
        && existsAfter(/databases/$(database)/documents/serialLookups/$(incoming().serialCode));

      allow update: if isValidId(appointmentId)
        && isValidAppointment(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().serialCode == existing().serialCode
        && (
          isAdmin() ||
          (
            isVerifiedUser()
            && existing().patientUid == request.auth.uid
            && existing().status in ['pending', 'confirmed']
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isValidId(appointmentId) && isAdmin();
    }

    // --- Collection: serialLookups (Non-PII public lookup by exact serialCode) ---
    match /serialLookups/{serialCode} {
      allow get: if isValidId(serialCode);
      allow list: if false;

      allow create: if isValidId(serialCode)
        && isValidSerialLookup(incoming(), serialCode)
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(serialCode)
        && isValidSerialLookup(incoming(), serialCode)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().serialCode == existing().serialCode
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isValidId(serialCode) && isAdmin();
    }

    // --- Collection: contactMessages ---
    match /contactMessages/{messageId} {
      allow get: if isValidId(messageId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isValidId(messageId)
        && isValidContactMessage(incoming())
        && incoming().status == 'unread'
        && incoming().createdAt == request.time;

      allow update: if isValidId(messageId)
        && isValidContactMessage(incoming())
        && incoming().createdAt == existing().createdAt
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);

      allow delete: if isValidId(messageId) && isAdmin();
    }

    // --- Collection: admins ---
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(adminId) && isAdmin() && isValidAdmin(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(adminId) && isAdmin() && isValidAdmin(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(adminId) && isAdmin();
    }
  }
}
